     "t": "ومن هؤلاء العالِم، والمخترع الذي يبتكر كل جديد، والمهندس، وصاحب الشركات الكبرى."
    },
    {
     "e": "🏫❤️",
     "t": "كل هؤلاء تخرّجوا تحت يد المعلم في المدرسة، ويحفظون له كل الود والمحبة."
    },
    {
     "e": "📚🪔",
     "t": "والمعلم لا يدرّس المادة العلمية فقط، بل يعلّم الطلاب العلم والأخلاق والنظام، فهو السراج الذي يستنيرون به."
    },
    {
     "e": "📅🎉",
     "t": "ولهذه الأسباب يحتفل العالم في يوم الخامس من أكتوبر من كل عام بيوم المعلم."
    },
    {
     "e": "🏖️🌍",
     "t": "وبعض الدول تجعل يوم المعلم عطلةً رسمية، وبعضها يحتفل به والمعلم في ميدان العلم والعمل."
