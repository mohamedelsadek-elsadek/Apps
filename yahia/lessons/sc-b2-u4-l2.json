   "scenes": [
    {
     "e": "🪨💧💨",
     "t": "Matter is anything that takes up space. Matter can be a solid, a liquid or a gas."
    },
    {
     "e": "🍫🔥",
     "t": "Matter can change from one state to another by heating or cooling."
    },
    {
     "e": "🍫➡️🫗",
     "t": "Melting is when a solid changes into a liquid by heating. Chocolate melts in the hot sun!"
    },
    {
     "e": "💧➡️💨",
     "t": "Evaporation is when a liquid changes into a gas by heating. Water becomes water vapour."
    },
    {
     "e": "💧➡️🧊",
     "t": "Freezing is when a liquid changes into a solid by cooling. Water in the freezer becomes ice."
    },
    {
     "e": "💨➡️💧",
     "t": "Condensation is when a gas changes into a liquid by cooling. Water vapour becomes water drops."
    },
    {
     "e": "🪟💧❄️",
     "t": "In winter we see drops of water on the windows. Warm air meets the cold glass, cools down and forms water droplets. That is condensation!"
    },
    {
     "e": "🎈💨",
     "t": "The air we blow into a balloon is a gas. Gases spread out to fill their container."
    }
   ]
  },
