    "or"
   ],
   "scenes": [
    {
     "e": "🔗",
     "t": "Linking words join our ideas: and, but, or, because, and so."
    },
    {
     "e": "🍎",
     "t": "We use and for things that go together: I like apples and bananas."
    },
    {
     "e": "🐻",
     "t": "We use but to show a difference: The teddy is big but soft."
    },
    {
     "e": "🍵",
     "t": "We use or for a choice: Do you want tea or juice?"
    },
    {
     "e": "😊",
     "t": "We use because to give a reason: I am happy because I am learning English."
    },
    {
     "e": "☔",
     "t": "We use so for a result: It was raining, so I stayed home."
    },
    {
     "e": "❓",
     "t": "Question words help us ask: who for people, what for things, where for places, when for time, and why for reasons."
    }
   ]
  },
