   "scenes": [
    {
     "e": "🎨",
     "t": "An adjective describes a person, animal, or thing. The boy is careful. The car is fast."
    },
    {
     "e": "🏃",
     "t": "An adverb describes a verb: how someone does something. The boy walks carefully. The car goes fast."
    },
    {
     "e": "✏️",
     "t": "Look: quick becomes quickly, slow becomes slowly, happy becomes happily, and sad becomes sadly."
    },
    {
     "e": "🌙",
     "t": "Loud becomes loudly, and quiet becomes quietly. Easy becomes easily, and angry becomes angrily."
    },
    {
     "e": "⭐",
     "t": "Some words stay the same: fast is fast, hard is hard, and early is early."
    },
    {
     "e": "🏆",
     "t": "And one word is special: good becomes well. Yahia plays football well!"
    }
   ]
  },
