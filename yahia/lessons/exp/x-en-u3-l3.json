   "scenes": [
    {
     "e": "🚗",
     "t": "{name} reads about Samy. One day, Samy was playing in his room when his toy car rolled under the couch."
    },
    {
     "e": "🪟",
     "t": "He looked for it behind the curtain and in front of the TV, but it was gone."
    },
    {
     "e": "🪑🪑",
     "t": "Then, he checked between the two chairs."
    },
    {
     "e": "😮",
     "t": "Samy found the car, but it was stuck. His sister came to help."
    },
    {
     "e": "🥢",
     "t": "She used a stick to pull it out from under the couch."
    },
    {
     "e": "😊",
     "t": "Samy was so happy! He put the toy car on the table and smiled."
    },
    {
     "e": "📦🐱",
     "t": "Prepositions tell us where something is: on, under, behind, in front of, between, in, next to."
    }
   ]
