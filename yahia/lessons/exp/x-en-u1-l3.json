     "e": "📏💇",
     "t": "Looks: tall, short, curly hair, straight hair, long hair, short hair, brown eyes."
    },
    {
     "e": "😄",
     "t": "Personality: funny, shy, friendly, helpful, polite. I am funny. I make my friends laugh."
    },
    {
     "e": "👧",
     "t": "This is my friend Mona. She has long black hair and brown eyes."
    },
    {
     "e": "💛",
     "t": "Mona is very kind and friendly. She always helps her friends when they need help."
    },
    {
     "e": "🤗",
     "t": "Everyone likes to play with Mona. It is good to help your friends when in need."
    },
    {
     "e": "🔤",
     "t": "We use 'to be': I am, you are, he is, she is, it is, we are, they are."
    }
