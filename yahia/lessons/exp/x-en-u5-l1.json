{"title": "Teamwork & Chores", "activities": [{"type": "story", "title": "Having Fun", "ico": "📖", "keys": ["chores", "tidy up", "clean", "share", "care", "win", "cheer", "plant", "donate"], "scenes": [{"e": "🏠", "t": "{name} reads about Mona and Karim. Mona and Karim are at home."}, {"e": "🧹", "t": "Their mother asks them to do some chores."}, {"e": "🛋️", "t": "First, they tidy up the living room."}, {"e": "🧽", "t": "Then, they clean the table and the floor."}, {"e": "🤝", "t": "Mona and Karim work together and share the chores. They are happy to help."}, {"e": "✨", "t": "Finally, the house looks clean. Their mother smiles and says, 'Good job, team!'"}]}, {"type": "cards", "title": "New Words", "ico": "🃏", "items": [{"w": "chores", "e": "🧹", "k": "mean", "a": "Jobs we do at home."}, {"w": "tidy up", "e": "🛏️", "k": "mean", "a": "Put things in their places."}, {"w": "clean", "e": "🧽", "k": "mean", "a": "Make something not dirty."}, {"w": "share", "e": "🍪", "k": "mean", "a": "Give part of what you have."}, {"w": "care", "e": "💗", "k": "mean", "a": "Be kind and help someone."}, {"w": "cheer", "e": "📣", "k": "mean", "a": "Shout to support someone."}, {"w": "plant", "e": "🌱", "k": "mean", "a": "Put a flower or tree in the ground."}, {"w": "donate", "e": "🎁", "k": "mean", "a": "Give things to help people."}]}, {"type": "match", "title": "Memory Game", "ico": "🧠", "prompt": "Match the sentence with the action.", "pairs": [["Ahmed gives clothes to people.", "donate"], ["The boys win the match.", "win"], ["Lina hugs her sad friend.", "care"], ["The boys shout for Omar.", "cheer"], ["Sara gives her sister food.", "share"], ["You put your bed in order.", "tidy up"]]}, {"type": "sort", "style": "bird", "title": "Helping at Home?", "ico": "🐦", "prompt": "Is it a chore at home?", "bins": [{"id": "y", "label": "Chore ✅", "ico": "🧹", "cls": "noun"}, {"id": "n", "label": "Not a chore", "ico": "🎮", "cls": "verb"}], "why": {"y": "It helps keep the house clean.", "n": "It is fun, not a