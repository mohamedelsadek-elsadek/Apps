   "scenes": [
    {
     "e": "😊😢",
     "t": "{name} learns about feelings: happy, sad, excited, angry, shy, tired, bored, scared."
    },
    {
     "e": "🌳🐱",
     "t": "Adam and Omar were playing in the garden when they heard a cat cry."
    },
    {
     "e": "👂",
     "t": "Then, they quickly followed the sound, and soon they saw the cat stuck in a fence."
    },
    {
     "e": "🤝",
     "t": "Because the hole was small, Adam held the fence while Omar carefully pulled the cat out."
    },
    {
     "e": "🐈💖",
     "t": "Finally, the cat jumped free and licked their hands."
    },
    {
     "e": "🏅",
     "t": "Since they worked as a team, they saved the cat. They felt happy and proud."
    },
    {
     "e": "🔁",
     "t": "Some verbs are irregular: is → was, are → were, do → did, see → saw, come → came, have → had, go → went, eat → ate."
    }
   ]
  },
